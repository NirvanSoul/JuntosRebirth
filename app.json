{
  "expo": {
    "name": "juntoss",
    "slug": "juntoss",
    "scheme": "juntoss",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juntoss.app",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.juntoss.app",
      "predictiveBackGestureEnabled": true
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-document-picker",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Juntoss necesita acceso a tus fotos para que elijas una imagen de perfil.",
          "cameraPermission": "Juntoss necesita acceso a la cámara para tomar tu foto de perfil.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "./plugins/withIosBuildFixes"
    ]
  }
}
