{
  "name": "juntoss",
  "version": "0.1.0-alpha",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --lan",
    "dev": "expo start --go --lan",
    "start:lan": "expo start --go --lan",
    "start:dev-client": "expo start --dev-client --lan",
    "tunnel": "sh scripts/tunnel.sh",
    "start:tunnel": "npm run tunnel",
    "upload": "sh scripts/git-upload.sh",
    "download": "sh scripts/git-download.sh",
    "android": "expo start --go --android",
    "ios": "expo start --go --tunnel",
    "ios:sim": "xcrun simctl openurl booted",
    "prebuild:ios": "sh scripts/ios-development-build.sh prebuild",
    "ios:dev": "sh scripts/ios-development-build.sh simulator",
    "ios:device": "sh scripts/ios-development-build.sh device",
    "typecheck": "tsc --noEmit",
    "lint": "npm run check:suppressions && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "check:suppressions": "node scripts/check-exhaustive-deps-suppressions.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "generate:legal-site": "npx tsx scripts/generate-legal-site.ts",
    "generate:oss-licenses": "sh scripts/generate-oss-licenses.sh"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/drawer": "^7.13.10",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "better-auth": "^1.7.2",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/JuntosRebirth-fase3/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|phosphor-react-native))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
