{
  "name": "juntoss",
  "version": "0.1.0-alpha",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --lan",
    "dev": "expo start --go --lan",
    "start:lan": "expo start --go --lan",
    "start:dev-client": "expo start --dev-client --lan",
    "tunnel": "sh scripts/tunnel.sh",
    "start:tunnel": "npm run tunnel",
    "upload": "sh scripts/git-upload.sh",
    "download": "sh scripts/git-download.sh",
    "android": "expo start --go --android",
    "ios": "npm run tunnel",
    "ios:sim": "xcrun simctl openurl booted",
    "prebuild:ios": "sh scripts/ios-development-build.sh prebuild",
    "ios:dev": "sh scripts/ios-development-build.sh simulator",
    "ios:device": "sh scripts/ios-development-build.sh device",
    "prebuild:android": "expo prebuild --platform android",
    "android:dev": "expo run:android",
    "android:device": "expo run:android --device",
    "typecheck": "tsc --noEmit",
    "lint": "npm run check:suppressions && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "check:suppressions": "node scripts/check-exhaustive-deps-suppressions.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "generate:legal-site": "npx tsx scripts/generate-legal-site.ts",
    "generate:oss-licenses": "sh scripts/generate-oss-licenses.sh"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@microsoft/react-native-clarity": "^4.9.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/drawer": "^7.13.10",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "better-auth": "^1.7.2",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.5.11",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver.js",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/JuntosRebirth-fase3/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|phosphor-react-native))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
