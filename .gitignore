# dependencies
node_modules/

# Expo and generated output
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native projects (Expo CNG)
/android/
/ios/

# Tests
coverage/

# Local environment files (the example is versioned)
.env
.env.*
!.env.example

# Native credentials and generated files
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# Tooling
.metro-health-check*
*.tsbuildinfo
supabase/.temp/
npm-debug.*
yarn-debug.*
yarn-error.*
.git-commit-*.txt

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Artefactos de trabajo de agentes (nunca se versionan). Los patrones son
# amplios a propósito: un documento legítimo con estas subcadenas (p. ej.
# HANDOFF_POLICY.md) debe forzarse con `git add -f` y revisarse.
*HANDOFF*.md
*IMPLEMENTATION_STATE*.md
*CONTEXT_ENGINE*.md

# Bundles de traspaso entre maquinas (git bundle). Son el vehiculo del
# codigo, no codigo: pesan decenas de MB y su contenido ya esta en el
# historial.
*.bundle
